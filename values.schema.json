{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "planpal chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "serviceAccount",
    "config",
    "externalSecrets",
    "workloads",
    "seedJob",
    "ingress",
    "tests"
  ],
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceQuantities"
        },
        "limits": {
          "$ref": "#/definitions/resourceQuantities"
        }
      }
    },
    "resourceQuantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": {
          "type": [
            "string",
            "number"
          ]
        },
        "memory": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "probeTiming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Deployment",
            "StatefulSet"
          ]
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "serviceAccount": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "configMaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preStopSleep": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "exec": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "readiness": {
              "$ref": "#/definitions/probeTiming"
            },
            "liveness": {
              "$ref": "#/definitions/probeTiming"
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "path",
                "port"
              ]
            }
          ]
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ports"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "headless": {
              "type": "boolean"
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "port"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  },
                  "targetPort": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "hpa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "pdb": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "mountPath",
            "storageClass",
            "size"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "mountPath": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string"
            }
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "description": "Replace the Deployment with an Argo Rollout for progressive delivery. Requires the argo-rollouts controller in the cluster.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "strategy": {
              "type": "string",
              "enum": [
                "blueGreen",
                "canary"
              ],
              "default": "blueGreen"
            },
            "activeService": {
              "type": "string"
            },
            "previewService": {
              "type": "string"
            },
            "autoPromotionEnabled": {
              "type": "boolean"
            },
            "scaleDownDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "setWeight": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "pause": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "duration": {
                        "type": [
                          "string",
                          "integer"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "pullPolicy"
      ],
      "properties": {
        "registry": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "backend",
        "frontend"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "backend": {
          "type": "string"
        },
        "frontend": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "region": {
          "type": "string"
        },
        "awsSecretName": {
          "type": "string"
        },
        "refreshInterval": {
          "type": "string"
        },
        "storeName": {
          "type": "string"
        }
      }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/workload"
      }
    },
    "seedJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "command"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "certificateArn": {
          "type": "string"
        },
        "healthcheckPath": {
          "type": "string"
        },
        "groupName": {
          "type": "string"
        },
        "groupOrder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        }
      }
    }
  }
}